<div class="searches__logo small">
  <%= link_to root_path do %>
    <%= render "common/logo" %>
  <% end %>
</div>

<div>
  <div class="btn__group margin-block-end">
    <%= link_to "All", searches_path, class: "btn btn-faint" %>
    <%= link_to "Active", searches_path(status: "active"), class: "btn btn-faint" %>
    <%= link_to "Inactive", searches_path(status: "inactive"), class: "btn btn-faint" %>
  </div>
  <div
    class="vstack gap-double"
    data-controller="navigable-list"
    data-action="
          keydown->navigable-list#navigate 
          click@document->navigable-list#deselectWhenClickingOutside
        "
    <%= "data-navigable-list-auto-select-value=false" if @selected_search_id %>
    data-navigable-list-prevent-handled-keys-value="true"
  >
    <% if @searches.any? %>
      <%= render "searches/display/collection", searches: @searches %>
    <% else %>
      <div class="searches__empty padding-double">
        <div class="vstack gap-half centered">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            fill="currentColor"
            viewBox="0 0 256 256"
            class="text-faint"
          >
            <path
              d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z"
            ></path>
          </svg>

          <% case params[:status] %>
          <% when "active" %>
            <p class="searches__empty-message">No active searches</p>
            <p class="text-small text-faint">Activate a search to start tracking it.</p>
          <% when "inactive" %>
            <p class="searches__empty-message">No inactive searches</p>
            <p class="text-small text-faint">Searches you deactivate will show up here.</p>
          <% else %>
            <p class="searches__empty-message">No saved searches yet</p>
            <p class="text-small text-faint">
              <%= link_to "Run a search", root_path, class: "searches__empty-link" %>
              and save it, or create one from scratch below.
            </p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= link_to "New search", new_search_path, class: "btn btn-faint btn-wide bordered margin-block-start-double", data: { controller: "hotkey", action: "keydown.c@document->hotkey#click" } %>

<%= render "searches/appbar", pins: @pins %>
